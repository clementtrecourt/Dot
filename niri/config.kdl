// ============================================================
// Niri config — Catppuccin Mocha
// À placer dans ~/.config/niri/config.kdl
// (ou géré via home-manager, cf. note en bas)
// ============================================================

// ---------- Entrée (clavier / touchpad / souris) ----------
input {
    keyboard {
        xkb {
            layout "us"
            // variant "oss"  // décommente si tu utilises la variante "oss" ou "bepo" etc.
        }
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
        accel-profile "adaptive"
        dwt // disable-while-typing
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }

    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
}

// ---------- Sorties ----------
// Ajuste "eDP-1" / résolution / position selon `niri msg outputs`
output "eDP-1" {
    scale 1.0
    // position x=0 y=0
}

// ---------- Général ----------
prefer-no-csd

screenshot-path "~/Images/Screenshots/niri-%Y-%m-%d-%H-%M-%S.png"
