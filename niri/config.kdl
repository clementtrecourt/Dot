// ---------- Démarrage ----------
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swaybg" "-i" "~/Images/wallpapers/current.jpg" "-m" "fill"
spawn-at-startup "swayidle" "-w" \
    "timeout" "300" "swaylock -f" \
    "timeout" "600" "niri msg action power-off-monitors" \
    "before-sleep" "swaylock -f"
spawn-at-startup "xwayland-satellite" // si tu as besoin de X11 (apps legacy)

// ---------- Layout ----------
layout {
    gaps 12

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#b4befe"     // Lavender
        inactive-color "#313244"   // Surface0
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#11111b70" // Crust, semi-transparent
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    insert-hint {
        color "#cba6f766" // Mauve translucide
    }
}

// ---------- Animations ----------
animations {
    // slowdown 1.0

    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
}

// ---------- Règles de fenêtres ----------
window-rule {
    // Coins arrondis partout
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id="^firefox$"
    default-column-width { proportion 0.66667; }
}

window-rule {
    match app-id="^org.wezfurlong.wezterm$"
    match app-id="^kitty$"
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="^mpv$"
    open-floating true
}

window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

window-rule {
    match app-id="^pavucontrol$"
    match app-id="^blueman-manager$"
    open-floating true
}

window-rule {
    match is-active=false
    opacity 0.95
}

// ---------- Workspaces nommés (optionnel) ----------
workspace "chat"
workspace "code"
workspace "www"
workspace "misc"

// ---------- Raccourcis clavier ----------
binds {
    // --- Apps ---
    Mod+Return { spawn "kitty"; }
    Mod+D { spawn "wofi" "--show" "drun"; }
    Mod+Shift+D { spawn "wofi" "--show" "run"; }
    Mod+E { spawn "nautilus"; }
    Mod+B { spawn "firefox"; }
    Mod+Escape { spawn "wlogout"; }

    // --- Fermer / quitter ---
    Mod+Q { close-window; }
    Mod+Shift+P { power-off-monitors; }

    // --- Focus colonnes/fenêtres ---
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    // --- Déplacer colonnes/fenêtres ---
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }

    // --- Aller au début / fin ---
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // --- Workspaces ---
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // --- Taille des colonnes ---
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // --- Flottant ---
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // --- Colonnes : consommer/expulser ---
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // --- Redimensionnement souris ---
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- Screenshots ---
    Print { screenshot; }
    Mod+Print { screenshot-screen; }
    Shift+Print { screenshot-window; }

    // --- Verrouillage ---
    // Remplace l'ancien spawn swaylock direct : inir pilote le lockscreen du shell.
    Mod+Alt+L allow-when-locked=true { spawn "inir" "lock" "activate"; }

    // --- Volume / luminosité ---
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }

    // --- iNiR (shell) ---
    Mod+Space { spawn "inir" "overview" "toggle"; }
    Mod+G { spawn "inir" "overlay" "toggle"; }
    Mod+Ctrl+V { spawn "inir" "clipboard" "toggle"; }              // Super+V du doc entrait en conflit avec le floating
    Alt+Tab { spawn "inir" "altSwitcher" "next"; }
    Alt+Shift+Tab { spawn "inir" "altSwitcher" "previous"; }
    Mod+Shift+S { spawn "inir" "region" "screenshot"; }
    Mod+Shift+X { spawn "inir" "region" "ocr"; }
    Mod+Shift+A { spawn "inir" "region" "search"; }
    Mod+Alt+V { spawn "inir" "voiceSearch" "toggle"; }             // Super+Shift+V du doc entrait en conflit avec switch-focus-floating
    Mod+Shift+E { spawn "inir" "session" "toggle"; }
    Mod+Slash { spawn "inir" "cheatsheet" "toggle"; }              // Super+Slash du doc entrait en conflit avec show-hotkey-overlay
    Mod+Shift+Comma { spawn "inir" "settings"; }                   // Super+Comma du doc entrait en conflit avec consume-window-into-column
    Mod+Shift+Space { spawn "inir" "globalActions" "open"; }       // Super+Slash du doc était déjà pris par le cheatsheet ci-dessus
    Mod+M { spawn "inir" "globalActions" "run" "toggle-mute"; }
    Ctrl+Alt+T { spawn "inir" "wallpaperSelector" "toggle"; }
    Ctrl+Mod+Space { spawn "inir" "mpris" "playPause"; }
    Mod+Alt+N { spawn "inir" "mpris" "next"; }
    Mod+Alt+P { spawn "inir" "mpris" "previous"; }
    Mod+F12 { spawn "inir" "gamemode" "toggle"; }
    Mod+Shift+W { spawn "inir" "panelFamily" "cycle"; }
    Mod+Shift+C { spawn "inir" "colorpicker"; }
    Mod+W { spawn "inir" "background" "toggleEditMode"; }

    // --- Quitter niri (session) ---
    Mod+Shift+Q { quit skip-confirmation=true; }
}

// ---------- Cursor ----------
cursor {
    xcursor-theme "catppuccin-mocha-lavender-cursors"
    xcursor-size 24
}

// ---------- Environnement (variables passées aux apps) ----------
environment {
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt5ct"
    MOZ_ENABLE_WAYLAND "1"
    NIXOS_OZONE_WL "1"
}
