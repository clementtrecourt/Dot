layout {

    focus-ring {
        active-color   "#a4caf2"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a4caf2"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a4caf2"
        inactive-color "#0d3a5b"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a4caf280"
    }
}

recent-windows {
    highlight {
        active-color "#a4caf2"
        urgent-color "#ffb4ab"
    }
}
